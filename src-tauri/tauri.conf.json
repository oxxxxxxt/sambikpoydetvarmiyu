{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exam Ticket Trainer",
  "version": "0.1.0",
  "identifier": "com.local.exam-ticket-trainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Тренажер экзаменационных билетов",
